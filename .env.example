# ─── apps/api/.dev.vars (copy this block there for local Wrangler dev) ────────
JWT_SECRET=change_me_to_a_32_byte_hex_string
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CONTACT_EMAIL=you@example.com

# ─── Local Prisma generate only (not used at runtime) ────────────────────────
DATABASE_URL="file:./dev.db"

# ─── apps/web .env.local ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8787
