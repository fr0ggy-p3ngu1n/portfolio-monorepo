{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.3.3",
    "@hono/zod-validator": "^0.7.0",
    "@portfolio/shared": "workspace:*",
    "@prisma/adapter-d1": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "bcryptjs": "^3.0.0",
    "hono": "^4.12.2",
    "resend": "^6.0.0",
    "satori": "^0.19.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260304.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.68.0"
  }
}
